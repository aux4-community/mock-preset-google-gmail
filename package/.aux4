{
  "scope": "community",
  "name": "mock-preset-google-gmail",
  "version": "0.0.3",
  "description": "Gmail preset for aux4/mock (message list, get, send, trash, labels, batchModify)",
  "license": "Apache-2.0",
  "tags": [
    "aux4",
    "mock",
    "preset",
    "google",
    "gmail",
    "email",
    "test"
  ],
  "dependencies": [
    "aux4/mock@>=0.1.0",
    "community/mock-preset-google-auth"
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "mock",
          "execute": [
            "profile:mock"
          ],
          "help": {
            "text": "Programmable HTTP mock server for tests"
          }
        }
      ]
    },
    {
      "name": "mock",
      "commands": [
        {
          "name": "preset",
          "execute": [
            "profile:mock:preset"
          ],
          "help": {
            "text": "Apply a service preset to a running mock. Presets are installable packages (community/mock-preset-<service>) that add commands here."
          }
        }
      ]
    },
    {
      "name": "mock:preset",
      "commands": [
        {
          "name": "google",
          "execute": [
            "profile:mock:preset:google"
          ],
          "help": {
            "text": "Google presets. `auth` stands up the credentials every Google API needs; the per-service presets (community/mock-preset-google-<service>) add their endpoints here."
          }
        }
      ]
    },
    {
      "name": "mock:preset:google",
      "commands": [
        {
          "name": "gmail",
          "execute": [
            "aux4 mock stub param(port) param(name) param(stateDir) --method GET --path /users/me/messages --status 200 --body value(messagesBody)",
            "file:${thenFile}:${sentThenBody}",
            "file:${sentBodyFile}:${sentBody}",
            "aux4 mock stub param(port) param(name) param(stateDir) --method POST --path /users/me/messages/send --status 200 --bodyFile ${sentBodyFile} --thenFile ${thenFile}",
            "aux4 mock stub param(port) param(name) param(stateDir) --method POST --path /users/me/messages/batchModify --status 204 --body '{}'",
            "aux4 mock stub param(port) param(name) param(stateDir) --method GET --path /users/me/labels --status 200 --body value(labelsBody)",
            "aux4 mock stub param(port) param(name) param(stateDir) --method GET --path '/users/me/messages/{id}' --status 200 --body value(messageBody)",
            "file:${thenFile}:${trashThenBody}",
            "aux4 mock stub param(port) param(name) param(stateDir) --method POST --path '/users/me/messages/{id}/trash' --status 200 --body value(trashBody) --thenFile ${thenFile}",
            "rm -f ${thenFile}",
            "rm -f ${sentBodyFile}"
          ],
          "help": {
            "text": "Register the Gmail API on a running mock: the message list, a message by id, send, trash, labels, and batchModify. Run `mock preset google auth` first for credentials",
            "variables": [
              {
                "name": "port",
                "text": "Port of the running mock server (derives stateDir)",
                "default": "7070"
              },
              {
                "name": "name",
                "text": "Stable handle of the server (derives stateDir; takes precedence over --port)",
                "default": ""
              },
              {
                "name": "stateDir",
                "text": "Explicit state directory (highest precedence)",
                "default": ""
              },
              {
                "name": "thenFile",
                "text": "Internal scratch file this command writes and reuses to pass --thenFile JSON to aux4/mock (the JSON references ${path.*}/${body.*}, whose names collide with this command's own --path/--body flags, so it must travel through a file rather than inline --then). Removed when the command finishes",
                "default": ".mock-preset-google-gmail-then-${port}${name}.json"
              },
              {
                "name": "messageId",
                "text": "Id of the message in the list and the send response. A get by any id echoes the id requested",
                "default": "18f8a9b0c1d2e3f4"
              },
              {
                "name": "threadId",
                "text": "Thread id carried by the message bodies",
                "default": "18f8a9b0c1d2e3f4"
              },
              {
                "name": "subject",
                "text": "Subject header of the message returned by get",
                "default": "Weekly update"
              },
              {
                "name": "from",
                "text": "From header of the message returned by get",
                "default": "sally@example.com"
              },
              {
                "name": "snippet",
                "text": "Preview text of the message returned by get",
                "default": "Hi there, this is a preview"
              },
              {
                "name": "messagesBody",
                "text": "Message list body (derived from --messageId/--threadId)",
                "default": "{\"messages\":[{\"id\":\"${messageId}\",\"threadId\":\"${threadId}\"}],\"resultSizeEstimate\":1}"
              },
              {
                "name": "messageBody",
                "text": "Single message body. Echoes back the id that was requested (derived from --subject/--from/--snippet)",
                "default": "{\"id\":\"${path.id}\",\"threadId\":\"${threadId}\",\"labelIds\":[\"INBOX\"],\"snippet\":\"${snippet}\",\"payload\":{\"headers\":[{\"name\":\"Subject\",\"value\":\"${subject}\"},{\"name\":\"From\",\"value\":\"${from}\"}]}}"
              },
              {
                "name": "sentBody",
                "text": "Response to a send (derived from --messageId/--threadId)",
                "default": "{\"id\":\"${sentMessageId}\",\"threadId\":\"${body.threadId:-${threadId}}\",\"labelIds\":[\"SENT\"]}"
              },
              {
                "name": "labelsBody",
                "text": "Label list body",
                "default": "{\"labels\":[{\"id\":\"INBOX\",\"name\":\"INBOX\",\"type\":\"system\"},{\"id\":\"SENT\",\"name\":\"SENT\",\"type\":\"system\"},{\"id\":\"Label_1\",\"name\":\"Work\",\"type\":\"user\"}]}"
              },
              {
                "name": "trashBody",
                "text": "Response to a trash call (derived from --threadId)",
                "default": "{\"id\":\"${path.id}\",\"threadId\":\"${threadId}\",\"labelIds\":[\"TRASH\"]}"
              },
              {
                "name": "sentThenBody",
                "text": "aux4/mock --then for a send: makes a later GET of the fixed --messageId return the sent message's to/subject/body. A field the send request did not include resolves to an empty string",
                "default": "[{\"method\":\"GET\",\"path\":\"/users/me/messages/${sentMessageId}\",\"status\":200,\"body\":\"{\\\"id\\\":\\\"${sentMessageId}\\\",\\\"threadId\\\":\\\"${body.threadId:-${threadId}}\\\",\\\"labelIds\\\":[\\\"SENT\\\"],\\\"snippet\\\":\\\"${body.body}\\\",\\\"payload\\\":{\\\"headers\\\":[{\\\"name\\\":\\\"To\\\",\\\"value\\\":\\\"${body.to}\\\"},{\\\"name\\\":\\\"Subject\\\",\\\"value\\\":\\\"${body.subject}\\\"}]}}\"}]"
              },
              {
                "name": "trashThenBody",
                "text": "aux4/mock --then for a trash: makes a later GET of that message id show the TRASH label in place of INBOX",
                "default": "[{\"method\":\"GET\",\"path\":\"/users/me/messages/${path.id}\",\"status\":200,\"body\":\"{\\\"id\\\":\\\"${path.id}\\\",\\\"threadId\\\":\\\"${threadId}\\\",\\\"labelIds\\\":[\\\"TRASH\\\"],\\\"snippet\\\":\\\"${snippet}\\\",\\\"payload\\\":{\\\"headers\\\":[{\\\"name\\\":\\\"Subject\\\",\\\"value\\\":\\\"${subject}\\\"},{\\\"name\\\":\\\"From\\\",\\\"value\\\":\\\"${from}\\\"}]}}\"}]"
              },
              {
                "name": "sentMessageId",
                "text": "Id given to a message sent through the mock (distinct from the inbox message, so reading the inbox message after a send still returns it).",
                "default": "msg-sent-0001"
              },
              {
                "name": "sentBodyFile",
                "text": "Scratch file the send response template is written to.",
                "default": ".mock-preset-google-gmail-sent-${port}${name}.json"
              }
            ]
          }
        }
      ]
    }
  ]
}